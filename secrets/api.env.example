# Plantilla de secretos compartidos por ads-api y ads-worker (T066;
# CommonSettings/ApiSettings/WorkerSettings en composition/settings.py).
# Copiar a `secrets/api.env`, rellenar y fijar permisos:
#
#   cp secrets/api.env.example secrets/api.env
#   chmod 600 secrets/api.env
#
# `secrets/` esta en .gitignore -- NUNCA se commitea `secrets/api.env`.
# ads-api y ads-worker montan este fichero (compose.yaml `env_file:`);
# ads-broker no lo ve, y nunca ve credenciales de plataforma (esas viven
# unicamente en secrets/broker.env). `make check-secrets` verifica permisos
# 0600 y que no quede ningun valor de plantilla sin sustituir antes de
# `make up` (solo mira lineas `CLAVE=valor`, nunca comentarios como este).
#
# ADS_SINGLE_OWNER_MODE, ADS_TRUSTED_PROXY_HOPS y ADS_MCP_STATIC_TOKEN_ENABLED
# viven aqui y no en `.env` aunque no parezcan secretos: `compose.yaml` solo
# reenvia a ads-api/ads-worker las CINCO variables de `x-ads-app-env`
# (ADS_DATABASE_URL, ADS_BROKER_SOCKET, ADS_PUBLIC_BASE_URL, ADS_TZ,
# ADS_ACTIVE_HOURS) -- cualquier otra cosa puesta en `.env` llegaria inerte,
# nunca al proceso. `secrets/api.env` en cambio entra entero por `env_file:`.

# --- Modo de autoridad de /mcp (obligatorio) ---------------------------------
# `ads-api` EXIGE exactamente uno de los dos, nunca ninguno ni los dos: sin
# esto no arranca ("exactamente uno de
# ADS_SEAT_AUTHORITY_ENABLED/ADS_SINGLE_OWNER_MODE debe estar activo").
# `make first-run` ya lo escribe por ti; a mano, este es el valor correcto
# para un despliegue autoalojado de un solo propietario -- lo que este repo
# instala.
ADS_SINGLE_OWNER_MODE=true
# El otro modo, `ADS_SEAT_AUTHORITY_ENABLED=true` (+ `ADS_ENTERPRISE_ORIGIN`):
# el alta de usuarios la resuelve una consola externa (un Enterprise
# alojado), no este fichero. No lo actives salvo que sepas que corres
# detras de esa consola -- deja `ADS_SINGLE_OWNER_MODE=true` arriba y no
# declares esta variable.
#ADS_SEAT_AUTHORITY_ENABLED=true

# --- Aprobaciones firmadas ---------------------------------------------------
# Clave PRIVADA Ed25519 (par completo: `python -m safent_ads.tools.gen_keys`).
# Solo ads-api la tiene; ads-broker solo ve la publica (secrets/broker.env).
ADS_APPROVAL_SIGNING_KEY=change-me-ed25519-seed-base64

# --- Sesion y TOTP ------------------------------------------------------------
# 32 bytes aleatorios en base64 cada uno (p.ej. `openssl rand -base64 32`).
ADS_SESSION_SECRET=change-me-32-bytes-base64
ADS_TOTP_ENC_KEY=change-me-32-bytes-base64

# --- MCP (bearer de dueño, via de emergencia) --------------------------------
# OPCIONAL y APAGADO por omision: los agentes entran por OAuth
# (`ADS_MCP_OAUTH_ENABLED`, por defecto `true`) y el bearer estatico solo se
# enciende a proposito. Descomentar LAS DOS lineas o ninguna: con el
# interruptor en `true` y sin bearer, `ads-api` no arranca; con el bearer
# escrito y el interruptor apagado, el secreto se queda dormido en disco,
# que es justo lo que se evita dejandolo comentado.
# Bearer largo y aleatorio; rotable sin tocar el resto del entorno.
# CommonSettings solo admite un valor hoy -- rotacion sin downtime (varios
# bearer validos a la vez) queda fuera de este fichero hasta que
# ApiSettings/WorkerSettings lo soporten.
# ADS_MCP_STATIC_TOKEN_ENABLED=true
# ADS_MCP_TOKEN=un-bearer-largo-y-aleatorio

# --- Telegram (vista de propuestas, nunca la autoridad) ----------------------
# Opcionales: vacios o ausentes desactivan el bot (ads-api/ads-worker
# arrancan igual y avisan una vez con el evento de log
# `telegram_not_configured`) -- una instalacion limpia no trae el bot
# todavia, lo crea el propietario despues con @BotFather.
TELEGRAM_BOT_TOKEN=change-me-telegram-bot-token
# Lista JSON de chat_id del propietario (allow-list), no separada por comas
# (pydantic-settings JSON-decodifica antes de validar: `123,456` levanta
# SettingsError, no una lista de dos). Un id suelto tambien vale: `123456789`
# equivale a `[123456789]`.
TELEGRAM_OWNER_CHAT_IDS=[123456789]

# --- Login federado con Google (002b) ----------------------------------------
# Entrar al panel con la cuenta de Google en vez de con contrasena. APAGADO
# por defecto. Las CUATRO variables tienen que estar completas: si falta una,
# o la lista de correos queda vacia, el login federado queda cerrado y el
# servicio ARRANCA IGUAL (las rutas `/api/v1/auth/federated/*` no se montan;
# responden 404 por enrutado, nunca por una rama permisiva dentro del codigo).
#
# En la consola de Google, el cliente OAuth necesita EXACTAMENTE este redirect
# URI autorizado, sin barra final:
#
#   <ADS_PUBLIC_BASE_URL>/api/v1/auth/federated/callback
#
# Va bajo `/api` porque la cookie de sesion se emite con `path=/api`. Si
# `ADS_PUBLIC_BASE_URL` cambia, hay que dar de alta el nuevo en Google: el
# servidor no acepta ningun otro destino.
ADS_FEDERATED_LOGIN_ENABLED=false
ADS_GOOGLE_OIDC_CLIENT_ID=
# Secreto del cliente OAuth. Vive aqui (0600), nunca en `.env` ni en el
# `compose.yaml`, y nunca sale en logs ni en respuestas: es `SecretStr`.
ADS_GOOGLE_OIDC_CLIENT_SECRET=
# Direcciones COMPLETAS que pueden entrar, separadas por comas (tambien vale
# una lista JSON). Ni dominios sueltos ni comodines: cualquiera con una cuenta
# del dominio seria dueno del gasto publicitario. LISTA VACIA = LOGIN FEDERADO
# CERRADO -- nunca "vacia = todos". Es una pieza de seguridad, no de
# configuracion.
ADS_FEDERATED_ALLOWED_EMAILS=

# --- Respaldo cloud de creatividad (F4, opcional) ----------------------------
# Solo si el perfil `creative-local` (ComfyUI en la DGX) no esta disponible.
# Vacios por defecto: sin respaldo cloud hasta que se rellenen.
OPENAI_API_KEY=
FAL_KEY=
